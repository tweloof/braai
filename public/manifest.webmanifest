{
  "id": "/",
  "name": "Die Braai — braai.co.za",
  "short_name": "Die Braai",
  "description": "Phone companion for braai.co.za: this week’s published index, who is braaiing tonight, recipes for when the signal dies, and a log for the communal fire. Not a shop.",
  "start_url": "/app/?src=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#191512",
  "theme_color": "#191512",
  "lang": "en-ZA",
  "categories": ["food", "social", "lifestyle"],
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Tonight",
      "url": "/app/?src=shortcut#tonight",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Braai Index",
      "url": "/app/?src=shortcut#index",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Recipes",
      "url": "/recipes/?src=shortcut",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Feed the braai",
      "url": "/app/?src=shortcut#vuur",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
